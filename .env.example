# Sao chép thành .env khi chạy local. Không điền secret thật vào Git.
NODE_ENV=development
PORT=8000

# Bắt buộc
BOT_TOKEN=replace_with_telegram_bot_token
ADMIN_ID=123456789
DATABASE_URL=postgresql://username:password@localhost:5432/hendy_bot
DATABASE_SSL=false

# Render tự cung cấp RENDER_EXTERNAL_URL khi chạy trên Render.
# Local để trống biến này để bot dùng long polling.
RENDER_EXTERNAL_URL=
WEBAPP_URL=
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

# Secret riêng cho Telegram webhook (tùy chọn nhưng nên đặt trên production).
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret

# Webhook ngân hàng bị từ chối nếu chưa cấu hình secret này.
BANK_WEBHOOK_SECRET=

# Thông tin VietQR; không commit thông tin tài khoản thật nếu không muốn công khai.
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
GROUP_URL=
CHANNEL_URL=
