# Sao chép thành .env khi chạy local. Không commit secret thật.
NODE_ENV=development
PORT=8000
# Bot chính (bắt buộc)
BOT_TOKEN=your_primary_botfather_token
ADMIN_ID=your_primary_admin_telegram_id
# Bot thứ hai (tùy chọn)
BOT_SECOND_TOKEN=
BOT_SECOND_ADMIN_ID=
BOT_SECOND_USERNAME=
# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/hendy_bot
DATABASE_SSL=false
PGPOOL_MAX=10
# URL dịch vụ
RENDER_EXTERNAL_URL=
WEBAPP_URL=
MINI_APP_URL=
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
# Webhook secrets
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SECOND_WEBHOOK_SECRET=
BANK_WEBHOOK_SECRET=
# Đăng nhập website cũ: link one-time 5 phút
LEGACY_ACCOUNT_URL=
LEGACY_SESSION_SECRET=
# VietQR và cộng đồng
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
GROUP_URL=
CHANNEL_URL=
BOT_USERNAME=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
