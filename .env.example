WEBAPP_URL=
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

# Bắt buộc trên Render; tạo bằng: openssl rand -hex 32.
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret

# Webhook ngân hàng bị từ chối nếu chưa cấu hình secret này.
BANK_WEBHOOK_SECRET=

# Thông tin VietQR; không commit thông tin tài khoản thật nếu không muốn công khai.
