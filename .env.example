# Sao chép thành .env khi chạy local. Không commit secret thật.
NODE_ENV=development
PORT=8000

# Telegram Bot chính (bắt buộc)
BOT_TOKEN=your_primary_botfather_token
ADMIN_ID=your_primary_admin_telegram_id

# Telegram Bot thứ hai (tùy chọn)
BOT_SECOND_TOKEN=
BOT_SECOND_ADMIN_ID=

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/hendy_bot
DATABASE_SSL=false
PGPOOL_MAX=10

# URL dịch vụ. Local để trống RENDER_EXTERNAL_URL để dùng long polling.
RENDER_EXTERNAL_URL=
WEBAPP_URL=
MINI_APP_URL=
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

# Webhook secrets riêng cho từng bot (production)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SECOND_WEBHOOK_SECRET=
BANK_WEBHOOK_SECRET=

# VietQR và cộng đồng
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
GROUP_URL=
CHANNEL_URL=
BOT_USERNAME=

TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
