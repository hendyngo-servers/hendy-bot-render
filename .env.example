# Sao chép thành .env khi chạy local. Không điền secret thật vào Git.
NODE_ENV=development
PORT=8000

# Bắt buộc
BOT_TOKEN=your_botfather_token
ADMIN_ID=your_telegram_numeric_user_id
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
BOT_TOKEN=8884608128:AAF8uShput76kgk5p5_UQG_ycZbI9iZxM-Y
ADMIN_ID=8639286417
DATABASE_URL=postgresql://neondb_owner:npg_mRavNEed4h1b@ep-green-water-b3fjpxk7-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_SSL=true

# Render tự cung cấp RENDER_EXTERNAL_URL khi chạy trên Render.
# Local để trống biến này để bot dùng long polling.
RENDER_EXTERNAL_URL=
WEBAPP_URL=
MINI_APP_URL=
WEBAPP_URL=https://hendy-bot-render.onrender.com
MINI_APP_URL=https://hendy-bot-render.onrender.com
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

# Bắt buộc trên Render; tạo bằng: openssl rand -hex 32.
TELEGRAM_WEBHOOK_SECRET=replace_with_random_64_character_hex_secret
# Webhook ngân hàng bị từ chối nếu chưa cấu hình secret này.
BANK_WEBHOOK_SECRET=replace_with_random_bank_webhook_secret

# Thông tin VietQR; không commit thông tin tài khoản thật nếu không muốn công khai.
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
GROUP_URL=https://t.me/your_group
CHANNEL_URL=https://t.me/your_channel

# Username bot (không có ký tự @), dùng tạo link giới thiệu.
BOT_USERNAME=your_bot_username
BOT_USERNAME=hendymono_bot
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
